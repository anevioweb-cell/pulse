{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "bench-persistence",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "vite",
        "scripts/bench/persistence",
        "--config",
        "vite.config.ts",
        "--port",
        "5181",
        "--strictPort"
      ],
      "port": 5181
    },
    {
      "name": "storybook-static",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "6007",
        "--bind",
        "127.0.0.1",
        "--directory",
        "storybook-static"
      ],
      "port": 6007
    },
    {
      "name": "preview",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["vite", "preview", "--port", "4173", "--strictPort"],
      "port": 4173
    }
  ]
}
